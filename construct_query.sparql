# =========================================================================== #
# Neurobagel SPARQL CONSTRUCT Mapping Query (Updated & Optimised)
#
# Generates Neurobagel graph structures from NIDM entities.
# =========================================================================== #

PREFIX nidm: <http://purl.org/nidash/nidm#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX sio:  <http://semanticscience.org/ontology/sio.owl#>
PREFIX sio_res: <http://semanticscience.org/resource/>
PREFIX dct:  <http://purl.org/dc/terms/>
PREFIX dctypes: <http://purl.org/dc/dcmitype/>
PREFIX nfo:  <http://www.semanticdesktop.org/ontologies/2007/03/22/nfo#>
PREFIX onli: <http://neurolog.unice.fr/ontoneurolog/v3.0/instrument.owl#>
PREFIX ndar: <https://ndar.nih.gov/api/datadictionary/v2/dataelement/>
PREFIX ncicb: <http://ncicb.nci.nih.gov/xml/owl/EVS/Thesaurus.owl#>
PREFIX snomed: <http://purl.bioontology.org/ontology/SNOMEDCT/>
PREFIX nb:   <http://neurobagel.org/vocab/>
PREFIX np:   <https://github.com/nipoppy/pipeline-catalog/tree/main/processing/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>

CONSTRUCT {
    # Dataset
    ?dataset a nb:Dataset ;
        nb:hasLabel ?datasetTitle ;
        nb:hasSamples ?subjectNode .

    # Subject
    ?subjectNode a nb:Subject ;
        nb:hasLabel ?subjectLabel ;
        nb:hasSession ?phenoSessionNode , ?imagingSessionNode .

    # Phenotypic Session
    ?phenoSessionNode a nb:PhenotypicSession ;
        nb:hasLabel ?sessionLabel ;
        nb:hasAge ?ageVal ;
        nb:hasSex ?sexTermNode ;
        nb:hasAssessment ?assessTermNode .

    # Imaging Session
    ?imagingSessionNode a nb:ImagingSession ;
        nb:hasLabel ?sessionLabel ;
        nb:hasAcquisition ?acqNode .

    # Acquisition
    ?acqNode a nb:Acquisition ;
        nb:hasContrastType ?contrastTermNode .

    # Controlled term nodes
    ?sexTermNode a nb:Sex .
    ?assessTermNode a nb:Assessment .
    ?contrastTermNode a nb:Image .
}
WHERE {
    # 1. Project / Dataset
    ?project a nidm:Project .
    OPTIONAL { ?project dctypes:title ?projTitle . }
    OPTIONAL { ?project rdfs:label ?projTitle . }
    BIND(COALESCE(?projTitle, "Neurobagel Dataset") AS ?datasetTitle)
    BIND(IRI(CONCAT("http://neurobagel.org/vocab/", REPLACE(STR(?project), "^.*[/#]", ""))) AS ?dataset)

    # 2. Session
    ?session a nidm:Session ;
             dct:isPartOf ?project .
    OPTIONAL { ?session rdfs:label ?sLabel . }
    BIND(COALESCE(?sLabel, REPLACE(STR(?session), "^.*[/#]", "")) AS ?sessionLabel)

    # 3. Subject Association (Strictly sio:Subject role)
    ?acq a nidm:Acquisition ;
         dct:isPartOf ?session ;
         prov:qualifiedAssociation ?assoc .
    ?assoc prov:agent ?person ;
           prov:hadRole ?role .
    FILTER(?role IN (sio:Subject, sio_res:Subject))

    OPTIONAL { ?person ndar:src_subject_id ?srcId . }
    OPTIONAL { ?person rdfs:label ?pLabel . }
    OPTIONAL { ?person foaf:givenName ?givenName . }
    OPTIONAL { ?person foaf:familyName ?familyName . }
    BIND(COALESCE(?srcId, ?pLabel, CONCAT(STR(?givenName), " ", STR(?familyName)), ?givenName, REPLACE(STR(?person), "^.*[/#]", "")) AS ?subjectLabel)
    BIND(IRI(CONCAT("http://neurobagel.org/vocab/sub_", REPLACE(STR(?person), "^.*[/#]", ""))) AS ?subjectNode)

    # 4. Phenotypic data
    OPTIONAL {
        ?phenoAcq a nidm:Acquisition ;
                  dct:isPartOf ?session ;
                  prov:qualifiedAssociation ?phenoAssoc .
        ?phenoAssoc prov:agent ?person ;
                    prov:hadRole ?phenoRole .
        FILTER(?phenoRole IN (sio:Subject, sio_res:Subject))
        ?phenoObj prov:wasGeneratedBy ?phenoAcq .

        OPTIONAL { ?phenoObj ncicb:Age ?ageVal . }
        OPTIONAL {
            ?phenoObj ndar:gender ?genderRaw .
            BIND(IF(LCASE(STR(?genderRaw)) IN ("male", "m", "1"), snomed:248153007,
                 IF(LCASE(STR(?genderRaw)) IN ("female", "f", "2"), snomed:248152002,
                 snomed:32570681000036106)) AS ?sexTermNode)
        }
        OPTIONAL {
            ?phenoObj a onli:assessment-instrument .
            FILTER(!BOUND(?ageVal) && !BOUND(?genderRaw))
            BIND(snomed:assessment AS ?assessTermNode)
        }
        BIND(IRI(CONCAT("http://neurobagel.org/vocab/ses_pheno_", REPLACE(STR(?person), "^.*[/#]", ""), "_", REPLACE(STR(?session), "^.*[/#]", ""))) AS ?phenoSessionNode)
    }

    # 5. Imaging data
    OPTIONAL {
        ?imgAcq a nidm:Acquisition ;
                dct:isPartOf ?session ;
                prov:qualifiedAssociation ?imgAssoc .
        ?imgAssoc prov:agent ?person ;
                  prov:hadRole ?imgRole .
        FILTER(?imgRole IN (sio:Subject, sio_res:Subject))
        ?imgObj prov:wasGeneratedBy ?imgAcq .
        ?imgObj nidm:hadAcquisitionModality ?modality .

        OPTIONAL { ?imgObj nidm:hadImageContrastType ?contrastVal . }
        BIND(COALESCE(?contrastVal, nidm:T1Weighted) AS ?contrastTermNode)
        BIND(IRI(CONCAT("http://neurobagel.org/vocab/acq_", REPLACE(STR(?imgAcq), "^.*[/#]", ""))) AS ?acqNode)
        BIND(IRI(CONCAT("http://neurobagel.org/vocab/ses_img_", REPLACE(STR(?person), "^.*[/#]", ""), "_", REPLACE(STR(?session), "^.*[/#]", ""))) AS ?imagingSessionNode)
    }
}
